---
const { name, jobTitle, image, description } = Astro.props;
---

<div class="team-member-card">
  <img src={image} alt={name} class="rounded-full mx-auto mb-4">
  <h3 class="text-2xl font-semibold">{name}</h3>
  <p>{jobTitle}</p>
  <p class="text-brand-textGray text-sm mt-2">{description}</p>
</div>