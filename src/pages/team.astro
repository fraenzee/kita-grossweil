---
// Importiere das Basis-Layout
import BaseLayout from '../layouts/BaseLayout.astro';
// Importiere die Funktion zum Abrufen von Inhalten aus der "pages"-Sammlung
import { getCollection } from 'astro:content';


import { teamMembers, createPersonListSchema } from "../schema/personListSchema.js";
const title = "Unser Team";
const description = "Lernen Sie unser Team kennen, das sich mit Herz und Kompetenz für die Betreuung und Förderung Ihrer Kinder einsetzt.";

import TeamMember from "../components/TeamMember.astro";

const schema = [createPersonListSchema];

// Lade den Inhalt der "Team"-Seite aus der Markdown-Datei
const pages = await getCollection('pages');
const aboutPage = pages.find(page => page.slug === 'team'); // Finde die "team.md" Seite

// Stelle sicher, dass die Seite gefunden wurde, sonst leite um oder zeige Fehler
if (!aboutPage) {
  return Astro.redirect('/404'); // Oder eine andere Fehlerbehandlung
}

// Extrahiere den gerenderten Inhalt
const { Content } = await aboutPage.render();
---
<BaseLayout title={title}
  description={description}
  robots="noindex, follow"
  url="https://kita-grossweil.netlify.app/team/"
  schema={schema}>

    <section class="bg-white rounded-lg shadow-lg p-8 mb-8">
        <h1>{aboutPage.data.title}</h1>
        <div class="leading-relaxed mb-6">
            <Content /> <!-- Hier wird der Inhalt aus der Markdown-Datei eingefügt -->
        </div>

        <!-- Beispiel Teammitglieder (Diese bleiben vorerst hier, bis wir eine dynamische Lösung über das CMS haben) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
            {teamMembers.map(m => <TeamMember {...m} />)}
        </div>
    </section>

    <!-- <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)}></script> -->

</BaseLayout>