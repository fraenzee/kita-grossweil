---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const pages = await getCollection('pages');
const gruppenPage = pages.find(page => page.slug === 'gruppen');

if (!gruppenPage) {
  return Astro.redirect('/404');
}

import { Image } from 'astro:assets';
import sonnenkaefer from '../assets/bilder/sonnenkaefer-aquarell.webp';
import puma from '../assets/bilder/puma-aquarell.webp';
import delfin from '../assets/bilder/delfin-aquarell.webp';
import loewe from '../assets/bilder/loewe-aquarell.webp';
import giraffe from '../assets/bilder/giraffe-aquarell.webp';

const bildMapping = {
  sonnenkaefer,
  puma,
  delfin,
  loewe,
  giraffe,
};


const { Content } = await gruppenPage.render();
const { title, gruppen } = gruppenPage.data;
---

<BaseLayout title={title}>
  <section class="text-left bg-white rounded-lg shadow-lg p-8 mb-8">
    <div class="leading-relaxed bg-white">
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto max-w-2xl md:text-center">
          <p class="text-base/7 font-semibold font-body text-brand-textGray">{gruppenPage.data.subtitle}</p>
          <h1 class="leading-snug mt-2 text-4xl font-semibold tracking-tight font-patrick text-brand-secondary sm:text-5xl lg:text-balance">{gruppenPage.data.title}</h1>
        </div>
      </div>
    </div>
    <div class="max-w-3xl mx-auto mb-16 md:text-center">
      {gruppenPage.data.intro}
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-10 max-w-6xl mx-auto">
      {gruppen.map(gruppe => (
        // <div class="relative rounded-3xl p-[3px] bg-gradient-to-br from-adobeblue/20 to-adobepink/20 shadow-lg transition-transform duration-300"></div>
        // <div class="relative rounded-3xl p-[3px] bg-gradient-to-br from-brand-primary/10 to-brand-hoverSoft/20 shadow-lg transition-transform duration-300">
        <div class="relative rounded-3xl p-[3px] bg-brand-hoverSoft shadow-lg transition-transform duration-300">
          <div class="bg-brand-hoverSoft rounded-3xl overflow-hidden"></div>
          <div class="p-4 place-self-center pb-0"> <Image src={bildMapping[gruppe.bild]} 
          alt={gruppe.name} class="rounded-full border-4 border-brand-primary max-h-[200px] max-w-[200px]"/></div>

          <div class="relative p-6 text-center">
            <h2 class="text-2xl font-bold text-brand-secondary mb-3 tracking-widest">
              {gruppe.name}
            </h2>
            <p class="text-brand-text leading-relaxed">
              {gruppe.intro}
            </p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 max-w-3xl mx-auto md:text-center">
      <Content/>
    </div>

  </section>
</BaseLayout>