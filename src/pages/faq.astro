---
// Importiere das Basis-Layout
import BaseLayout from '../layouts/BaseLayout.astro';
// Importiere die Funktion zum Abrufen von Inhalten aus der "pages"-Sammlung
import { getCollection } from 'astro:content';

const title = "FAQ";
const description = "Häufig gestellte Fragen zur Kita St. Georg in Großweil.";

// Lade den Inhalt der "FAQ"-Seite aus der Markdown-Datei
const pages = await getCollection('pages');
const faqPage = pages.find(page => page.slug === 'faq'); // Finde die "faq.md" Seite

// Stelle sicher, dass die Seite gefunden wurde, sonst leite um oder zeige Fehler
if (!faqPage) {
  return Astro.redirect('/404'); // Oder eine andere Fehlerbehandlung
}

// Extrahiere den gerenderten Inhalt
const { Content } = await faqPage.render();
---
<BaseLayout title={title}
  description={description}
  robots="noindex, follow"
  url="https://kita-grossweil.netlify.app/faq/"
>

    <section class="bg-white rounded-lg shadow-lg p-8 mb-8">
        <h1 class="leading-snug">{faqPage.data.title}</h1>
        <div class="leading-relaxed mb-6 text-left ">
            <Content /> <!-- Hier wird der Inhalt aus der Markdown-Datei eingefügt -->
        </div>
    </section>
</BaseLayout>